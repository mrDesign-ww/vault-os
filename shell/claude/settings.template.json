    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
